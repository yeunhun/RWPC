# ENCRYPT Information

# CRCSUM Information
CRCSUM CRC16 I -r=ASW -w=0x10048810 -i=0x10048807 

# SIGINFO Information, Only FDT Enable support
SIGINFOCHECK I -r=0x10048000-0x100488FF, 0x10048C00-0x1020FFFF -w=0x10048C00

# Save Information
save 'Z:\01_SWP_Backup\mq4_pe_wpc_unit_development_ksn\Debug\e_ka4_pe_wpc_v200_intergration.s19' MOTO32 -r=ASW, ASW_CRC, SIGINFO

exit