# This is the UTIP Configuration File

# Init Area
INIT -r=0x10048000-0x1020FFFF

# Load file
LOAD Z:\01_SWP_Backup\mq4_pe_wpc_unit_development_ksn\Debug\e_ka4_pe_wpc_v200_intergration.sre

# Fill Area
FILL skip -r=0x10048000-0x1020FFFF -op=0xFF

# Section Area
SECTION 'ASW' -r=0x10048000-0x1004880F
SECTION 'ASW_CRC' -r=0x10048810-0x100488FF
SECTION 'ASW_SK' -r=0x10048900-0x100489FF
SECTION 'SIGNATURE' -r=0x10048A00-0x10048BFF
SECTION 'SIGINFO' -r=0x10048C00-0x10048CFF
