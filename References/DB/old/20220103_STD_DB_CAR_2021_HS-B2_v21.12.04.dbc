BA_ "Version" SG_ 2227254529 BAT_CurrVal "17.11.00";
BA_ "NmStationAddress" BU_ BLTN_CAM 72;
BA_ "NmNode" BU_ BLTN_CAM 1;
BA_ "Description" SG_ 2227254529 BAT_SocVal "[For 12V Lithium Battery vehicle model]
This signal is battery State of Charge as calculated by battery sensor.";
