BA_ "Description" SG_ 2382595329 OFFROAD_AppliedSta "This signal indicates whether the each offroad mode is applied or not.
For each bit value, 0x0 means 'Not Applied'. And 0x1 means 'Applied'.
 - Bit 0 : Snow
 - Bit 1 : Mud
 - Bit 2 : Sand
 - Bit 3 : Auto
 - Bit 4 : Deep Snow
 - Bit 5 : Reserved
 - Bit 6 : Reserved
 - Bit 7 : Reserved";
BA_ "GenSigStartValue" SG_ 2382595329 OFFROAD_AppliedSta 0;
BA_ "UserSigValidity" SG_ 2382595329 OFFROAD_AppliedSta 3;
BA_ "NetworkRequestHoldingTime" SG_ 2382595329 OFFROAD_AppliedSta 0;
BA_ "RoutingFactor" SG_ 2382595329 OFFROAD_AppliedSta 2;
BA_ "Version" SG_ 2382595329 OFFROAD_AppliedSta "20.09.00";
BA_ "Description" SG_ 2382595329 OFFROAD_TypeSta "This signal indicates the type of offroad mode function.
For each bit value, 0x0 means 'Not Applied'. And 0x1 means 'Applied'.
 - Bit 0 : Terrain Mode
 - Bit 1 : Traction Control";
BA_ "GenSigStartValue" SG_ 2382595329 OFFROAD_TypeSta 0;
BA_ "UserSigValidity" SG_ 2382595329 OFFROAD_TypeSta 3;
BA_ "NetworkRequestHoldingTime" SG_ 2382595329 OFFROAD_TypeSta 0;
