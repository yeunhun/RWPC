BA_ "Description" SG_ 2151682049 ACU_CrshActvSta "Information regarding the crash. It indicates crash is active or inactive.";
BA_ "GenSigSendType" SG_ 2151682049 ACU_CrshActvSta 2;
BA_ "GenSigStartValue" SG_ 2151682049 ACU_CrshActvSta 0;
BA_ "UserSigValidity" SG_ 2151682049 ACU_CrshActvSta 3;
