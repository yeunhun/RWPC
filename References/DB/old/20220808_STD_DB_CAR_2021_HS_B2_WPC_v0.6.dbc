BA_ "RoutingFactor" SG_ 2470760705 CLU_Crc5Val 1;
BA_ "Version" SG_ 2470760705 CLU_Crc5Val "18.11.08";
BA_ "Description" SG_ 2470760705 CLU_AlvCnt5Val "For the first transmission request for a data element the counter shall be initialized with 0 and shall be incremented by 1 for every subsequent send request. 
When the counter reaches the maximum value(0xFF), then it shall restart with 0 for the next send request";
BA_ "GenSigSendType" SG_ 2470760705 CLU_AlvCnt5Val 4;
BA_ "GenSigStartValue" SG_ 2470760705 CLU_AlvCnt5Val 0;
