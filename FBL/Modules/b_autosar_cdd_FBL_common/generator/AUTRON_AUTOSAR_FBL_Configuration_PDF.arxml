        <ECUC-MODULE-DEF UUID="ECUC:add28e00-89a6-55a7-91ec-b997291c0da6">
          <SHORT-NAME>Fbl</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Configuration of the FBL (Flash BootLoader) module.</L-2>
          </DESC>
          <ADMIN-DATA>
            <DOC-REVISIONS>
              <DOC-REVISION>
                <REVISION-LABEL>1.0.0</REVISION-LABEL>
                <REVISION-LABEL-P-1 />
                <ISSUED-BY>AUTRON</ISSUED-BY>
                <DATE>2019-08-01</DATE>
              </DOC-REVISION>
            </DOC-REVISIONS>
          </ADMIN-DATA>
          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
          <SUPPORTED-CONFIG-VARIANTS>
            <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
          </SUPPORTED-CONFIG-VARIANTS>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ae93e88d-7f5d-46ae-b993-47b9d13ad243">
              <SHORT-NAME>FblGeneral</SHORT-NAME>
