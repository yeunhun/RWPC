                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="edbaac80-7b97-4339-8b58-4a8f03723826">
                      <SHORT-NAME>FblCanIfCANFDDiscreteDlcSupport</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Selects support for CAN FD discrete DLC</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">True: Enabled
																										False: Disabled</L-1>
                        </P>
                      </INTRODUCTION>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
