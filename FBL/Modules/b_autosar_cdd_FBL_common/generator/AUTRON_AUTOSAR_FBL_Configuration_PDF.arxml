                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>FBL_MCU_TC38X</DEFAULT-VALUE>
