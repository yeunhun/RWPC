                  <SHORT-NAME>FblDiagMaxNumOfBlockLength</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">This parameter is used by the requestDownload positive response message to inform the client how many data bytes (maxNumberOfBlockLength) shall be included in each TransferData request message from the client. &#xD;
This length reflects the complete message length, including the service identifier and the data parameters present in the TransferData request message. &#xD;
This parameter allows the client to adapt to the receive buffer size of the server before it starts transferring data to the server.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
