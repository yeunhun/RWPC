                  <ORIGIN>AUTRON</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="e0786c82-6b35-45fc-843b-629b814ed463">
                  <SHORT-NAME>CLK_TRIM_ECO_GTRIM</SHORT-NAME>
                  <ORIGIN>AUTRON</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="007de112-9a2d-485c-9923-83f4ea07a89f">
