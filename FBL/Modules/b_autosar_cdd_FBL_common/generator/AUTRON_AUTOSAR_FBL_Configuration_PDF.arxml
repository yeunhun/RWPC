                      <SHORT-NAME>FBL_QUARTZ_20MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="262463d8-0cb8-4eaf-80b6-4c3042085c90">
                      <SHORT-NAME>FBL_QUARTZ_24MHZ</SHORT-NAME>
                      <ORIGIN />
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="0d3f05ff-ba20-49cd-9798-22e6603e00ac">
