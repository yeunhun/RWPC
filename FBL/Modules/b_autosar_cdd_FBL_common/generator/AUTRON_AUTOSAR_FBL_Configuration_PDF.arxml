                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="116c8560-04a9-4b50-b600-87c5793fab6e">
                      <SHORT-NAME>FBL_QUARTZ_40MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="b3e4cce3-982c-4fed-9a94-d72c873d3a09">
                  <SHORT-NAME>FblTimerPrescaler</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Timer prescaler used by FBL.&#xD;
TC23X does not use this value.&#xD;
TC3XX does not use this value.&#xD;
SPC58X use this value.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>1</DEFAULT-VALUE>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="295bb882-69f5-417f-ac72-690f24fe3d0a">
                  <SHORT-NAME>PllNDiv</SHORT-NAME>
