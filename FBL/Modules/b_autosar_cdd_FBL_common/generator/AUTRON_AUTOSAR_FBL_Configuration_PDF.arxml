            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="75ef7c44-28ed-4518-8031-0d12b937c5e6">
              <SHORT-NAME>FblFlashConfig</SHORT-NAME>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-INTEGER-PARAM-DEF UUID="c90892ab-f42d-4405-acd8-d87a3f0e5128">
                  <SHORT-NAME>FblMainSwEntryAddress1</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Location of entry point 1 of Main SW</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="9d821d27-4e1b-4502-831c-09e7ecb4d72c">
                  <SHORT-NAME>FblMainSwEntryAddress2</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Location of entry point 2 of Main SW</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="d2682554-ca76-448c-b511-2798596c3b4f">
                  <SHORT-NAME>FblFlashAlignment</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Bytes for flash alignment.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>256</DEFAULT-VALUE>
                  <MIN>1</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="d7b926f5-ab46-4eef-b393-7694fc3c2030">
                  <SHORT-NAME>FblStartupCommandAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">RAM address for Main SW to apply startup command</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="3b73ce75-908f-42eb-8cf6-5ba53464da1b">
                  <SHORT-NAME>FblCommonRamAddress</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">RAM address shared by Main SW and FBL</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>0</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="1a7304df-3693-444c-8635-0d9bbe7ea693">
                  <SHORT-NAME>FblEraseSectorNum</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN" />
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="d2682554-ca76-448c-b511-2798596c3b4f">
                  <SHORT-NAME>FblFlashEraseUnit</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Bytes for flash erase max unit</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>1</MIN>
                </ECUC-INTEGER-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="5acd8c5e-9ac8-433b-b531-24c9625d64bc">
              <SHORT-NAME>FblSecurityConfig</SHORT-NAME>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-ENUMERATION-PARAM-DEF UUID="e0d3a58f-0336-42fc-9a41-77fa1a9b54b6">
                  <SHORT-NAME>FblCrc16BlockSize</SHORT-NAME>
                  <DESC>
                    <L-2 L="FOR-ALL">The block size in bytes for CRC16.&#xD;
CRC16BlockSize 4096 is OK, normally. &#xD;
But if external watchdog timeout is extremely short(shorter than 10ms), &#xD;
CRC16BlockSize have to be reduced.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>FBL_CRC16_BLOCK_4096_BYTES</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="c1952730-114b-4c40-a446-85acd90d5f44">
                      <SHORT-NAME>FBL_CRC16_BLOCK_4096_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="93ae2ad9-450f-400e-b540-d15d31df304b">
                      <SHORT-NAME>FBL_CRC16_BLOCK_2048_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="e96a97e3-fbb1-4cef-a8aa-d4623db8bb36">
                      <SHORT-NAME>FBL_CRC16_BLOCK_1024_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="21e0401a-9f4b-4998-abe5-79e507800203">
                      <SHORT-NAME>FBL_CRC16_BLOCK_512_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="5fd81a66-f268-4ca3-ad34-1f6035700901">
                      <SHORT-NAME>FBL_CRC16_BLOCK_256_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="89854521-7964-4f9a-bcbd-d83ca23ff014">
                      <SHORT-NAME>FBL_CRC16_BLOCK_128_BYTES</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
              </PARAMETERS>
              <SUB-CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="71f4e1d1-0ef4-4e2f-8b42-62ef26acd938">
                  <SHORT-NAME>FblSecurityAccess</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="088227ab-9543-4235-812c-6f4dc5da3e97">
                      <SHORT-NAME>FblSecurityAccessLevel</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Security level of security access&#xD;
FBL_SA_SEEDKEY : 4-byte based seedkey algorithm authentication&#xD;
FBL_SA_ADVANCED_SEEDKEY : 8-byte advanced seedkey algorithm authentication&#xD;
FBL_SA_SECUREACCESS_1_0 : Digital signature based authentication&#xD;
FBL_SA_SECUREACCESS_2_0 : Digital signature based authentication with CRL</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>FBL_SA_SEEDKEY</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="81333e0d-66dc-4e64-a884-e74a46428c6f">
                          <SHORT-NAME>FBL_SA_SEEDKEY</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="d2eb88e1-05d5-4b8a-a845-9f0d9afc52fe">
                          <SHORT-NAME>FBL_SA_ADVANCED_SEEDKEY</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="edc0e311-e66c-4945-b744-052dcdb39186">
                          <SHORT-NAME>FBL_SA_SECUREACCESS_1_0</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="2be4d811-9e0d-47a1-84d0-74770c5d4ce2">
                          <SHORT-NAME>FBL_SA_SECUREACCESS_2_0</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="8e4b9f2f-8770-458e-9dcf-f253437a76a7">
                      <SHORT-NAME>FblSecureAccessCertificateHashAlgorithm</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Hash algorithm used by certificate of secure access &#xD;
FBL_SA_HASH_SHA160 : SHA160 algorithm implemented by HAE SW library&#xD;
FBL_SA_HASH_SHA256 : SHA256 algorithm implemented by HAE SW library</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>FBL_SA_HASH_SHA160</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="3225c9b9-0cf6-4c02-87b3-f2c3d698a10d">
                          <SHORT-NAME>FBL_SA_HASH_SHA160</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="4b35514c-204a-4e75-944e-ddaf02933ca6">
                          <SHORT-NAME>FBL_SA_HASH_SHA256</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="50b369b1-286b-42d3-af7d-f3a92a94c53a">
                      <SHORT-NAME>FblSecurityNumAttDelay</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Number of failed security accesses after which the delay time is activated</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>3</DEFAULT-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="7a8f584a-cef3-46df-8e8f-125f7e11bb81">
                      <SHORT-NAME>FblSecurityDelayTime</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Delay time after failed security access (in ms). This is started after FblSecurityNumAttDelay number of failed security accesses.</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">The AUTOSAR configuration standard is to use SI units, so this parameter is defined as integer value in seconds. FBL configuration tools must convert this integer value to the appropriate value format for the use in the software implementation of FBL.&#xD;
&#xD;
                                                min:&#xD;
                                                A negative value is not allowed.&#xD;
&#xD;
                                                upperMultiplicity:&#xD;
                                                Exactly one delay time must be specified per security level configuration.&#xD;
&#xD;
                                                lowerMultiplicity:&#xD;
                                                Exactly one delay time must be specified per security level configuration.&#xD;
&#xD;
                                                origin:&#xD;
                                                Standard AUTOSAR configuration parameter.</L-1>
                        </P>
                      </INTRODUCTION>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>180</DEFAULT-VALUE>
                      <MAX>20000</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="f3563f75-3af9-49ce-90a3-05a82f41267e">
                  <SHORT-NAME>FblSecureFlash</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="e11e44f9-03a1-40b9-a7d2-e4f5915cddfc">
                      <SHORT-NAME>FblSecureFlashVersion</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">ES95489-52 Secure Flash Version.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>FBL_SF_CRC</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="108be6b0-07f9-4656-8fbb-4c77ecebc2d0">
                          <SHORT-NAME>FBL_SF_CRC</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="3225c9b9-0cf6-4c02-87b3-f2c3d698a10d">
                          <SHORT-NAME>FBL_SF_VER_1_0</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="e96955db-0e2a-4909-bbd7-88810b49b664">
                          <SHORT-NAME>FBL_SF_VER_2_0</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="4cb7e7cf-9e7d-496c-a15e-5153ec2db51d">
                      <SHORT-NAME>FblSecureFlashSignatureHashAlgorithm</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Hash algorithm used by secure flash&#xD;
FBL_SF_HASH_SHA160 : SHA160 algorithm implemented by HAE SW library&#xD;
FBL_SF_HASH_SHA256 : SHA256 algorithm implemented by HAE SW library</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>FBL_SF_HASH_SHA160</DEFAULT-VALUE>
                      <LITERALS>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="3225c9b9-0cf6-4c02-87b3-f2c3d698a10d">
                          <SHORT-NAME>FBL_SF_HASH_SHA160</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                        <ECUC-ENUMERATION-LITERAL-DEF UUID="e96955db-0e2a-4909-bbd7-88810b49b664">
                          <SHORT-NAME>FBL_SF_HASH_SHA256</SHORT-NAME>
                        </ECUC-ENUMERATION-LITERAL-DEF>
                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ed2a11aa-e64a-4484-b8c0-b2f331919ad1">
                      <SHORT-NAME>FblRevisedSecureFlash_2_0</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to apply revised secure flash 2.0</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="7ecd30ce-7f73-4d9a-ae06-8797f6baca6e">
                      <SHORT-NAME>FblWriteSignature</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to write the signature on flash memory</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="8f8b50f7-003a-4cfd-b9ed-3cce304f36ef">
                      <SHORT-NAME>FblWriteSignatureDelimiter</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to write the signature delimiter on flash memory&#xD;
Precondition : FblWriteSignature must be set.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </SUB-CONTAINERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="4cd8aaa8-6740-4398-92fc-d8cb7955efce">
              <SHORT-NAME>FblDiagConfig</SHORT-NAME>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-BOOLEAN-PARAM-DEF UUID="645089b5-adf3-46ad-a825-8431beae9363">
                  <SHORT-NAME>FblDiagResponseBeforeResetEnable</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Whether to respond before reset</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="22bd161a-08dc-4bc3-b715-62425bb67ab7">
                  <SHORT-NAME>FblDiagResponseBeforeSessionChangeEnable</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Whether to respond before session change</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>true</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
                <ECUC-INTEGER-PARAM-DEF UUID="c5b032b3-f313-46fb-8e4c-c55c367a967a">
                  <SHORT-NAME>FblDiagMaxNumResponsePending</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Maximum number of pending diagnostic response messages.&#xD;
Recommended value&#xD;
- TC38X : 25&#xD;
- TC39X : 35</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>25</DEFAULT-VALUE>
                  <MAX>255</MAX>
