                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="7d8cf14e-9661-41af-85a4-e6f1e6171692">
                      <SHORT-NAME>FblMemorySwapEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to support memory swap feature in FBL.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="9d492ed7-0c39-43b1-8f19-35c65621221a">
                      <SHORT-NAME>FblDecompressEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to use decompress freature.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="42126e44-0c3a-4d59-ad6c-031a77fdc0ec">
                      <SHORT-NAME>FblPartitionFlagAddress</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Partition flag address to check RTSW validity when using memory swap function.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="030287f6-aaf2-47e9-b1f4-3d3295ca0dcf">
                      <SHORT-NAME>FblPartitionFlagSize</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Size of partiton flag.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="14a7bedd-9d66-402b-84b5-862641f4b907">
                      <SHORT-NAME>FblOTAEnable</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Whether to use OTA freature.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <ORIGIN>AUTRON</ORIGIN>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF UUID="1fd50cb3-76a3-4c2f-b983-5ad7c67867bb">
                      <SHORT-NAME>FblDecompressBufSize</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Decompress buffer size</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
