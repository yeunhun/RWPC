            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="2bf8af6f-5354-46b2-ae0e-179aececcf5e">
              <SHORT-NAME>FblPllConfig</SHORT-NAME>
              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <PARAMETERS>
                <ECUC-ENUMERATION-PARAM-DEF UUID="9668f352-e87f-46e9-b75c-031ba531a829">
                  <SHORT-NAME>FblCpuClock</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">CPU frequency used by FBL.&#xD;
TC23X only supports 200 MHz.&#xD;
TC3XX only supports 300 MHz.&#xD;
SPC58X only supports 160 MHz.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>FBL_CPU_200MHZ</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="5a2c4a18-1aad-40dc-b017-410d7996ab46">
                      <SHORT-NAME>FBL_CPU_80MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="a1487366-15b9-4ea6-a14e-dfb09c4de16b">
                      <SHORT-NAME>FBL_CPU_160MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="400348ed-1f2d-4cab-b623-90d6bee348e7">
                      <SHORT-NAME>FBL_CPU_200MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="53785f8d-cdea-4549-a8b3-131ea906c84b">
                      <SHORT-NAME>FBL_CPU_300MHZ</SHORT-NAME>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="e1891145-f3f4-4bc6-8ad5-86c106e8bcb9">
                  <SHORT-NAME>FblQuartzClock</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Quartz frequency used by FBL.&#xD;
TC23X supports 40 MHz.&#xD;
TC3XX supports 20 MHz or 40 MHz.&#xD;
SPC58X supports 16 MHz or 40 MHz.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>FBL_QUARTZ_20MHZ</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="93b0fbc4-369f-40ca-8d30-53d8d880cb23">
