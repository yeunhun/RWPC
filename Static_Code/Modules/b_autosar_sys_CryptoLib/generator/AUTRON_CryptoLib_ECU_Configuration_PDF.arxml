                      <SHORT-NAME>CSEC_EEPROM_DATA_SET_SIZE_0B</SHORT-NAME>
                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="633d1f24-e0a0-4a0b-9dd7-e39ff8178e41">
