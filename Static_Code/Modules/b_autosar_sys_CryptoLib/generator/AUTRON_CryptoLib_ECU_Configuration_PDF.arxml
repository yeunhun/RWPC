                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="945380b5-0d64-487a-8020-2d1a9ec662eb">
