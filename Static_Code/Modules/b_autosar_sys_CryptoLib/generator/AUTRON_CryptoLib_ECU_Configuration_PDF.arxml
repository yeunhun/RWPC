                <ECUC-INTEGER-PARAM-DEF UUID="c6149996-4259-4702-9884-2281374462b6">
                  <SHORT-NAME>CryptoLibAutronCsecSecureBootSize</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The size in bits of the area to be checked for integrity by the secure boot process.&#xD;
The secure boot is run on the program flash block starting at address '0' and finishing at this bits size.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>8192</DEFAULT-VALUE>
                  <MAX>4294967295</MAX>
                  <MIN>1</MIN>
                </ECUC-INTEGER-PARAM-DEF>
                <ECUC-ENUMERATION-PARAM-DEF UUID="90da9309-ba3c-400b-b3b3-7a4b503b6933">
                  <SHORT-NAME>CryptoLibAutronCsecSecureBootFlavor</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Boot Flavor&#xD;
CSEC_SECURE_BOOT_NONE : No secure boot defined.&#xD;
CSEC_SECURE_BOOT_SERIAL : Application shall boot only after successful completion of secure boot.&#xD;
CSEC_SECURE_BOOT_PARALLEL : Secure boot and application boot shall happen in parallel. Also even if the secure boot fails, the application shall boot.&#xD;
CSEC_SECURE_BOOT_STRICT : If secure boot fails, the chip will not boot at all and will remain stuck in reset. Once set can't be changed.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>CSEC_SECURE_BOOT_NONE</DEFAULT-VALUE>
                  <LITERALS>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="5d7cfa01-da2d-4abd-9d31-24f8ad1138d6">
                      <SHORT-NAME>CSEC_SECURE_BOOT_NONE</SHORT-NAME>
                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="633d1f24-e0a0-4a0b-9dd7-e39ff8178e41">
                      <SHORT-NAME>CSEC_SECURE_BOOT_SERIAL</SHORT-NAME>
                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="0012d5b0-91f1-4ab0-8c9d-efdc78b2c6aa">
                      <SHORT-NAME>CSEC_SECURE_BOOT_PARALLEL</SHORT-NAME>
                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                    <ECUC-ENUMERATION-LITERAL-DEF UUID="e1195cd1-3085-4619-a516-113504d0c48f">
                      <SHORT-NAME>CSEC_SECURE_BOOT_STRICT</SHORT-NAME>
                      <ORIGIN>AUTRON</ORIGIN>
                    </ECUC-ENUMERATION-LITERAL-DEF>
                  </LITERALS>
                </ECUC-ENUMERATION-PARAM-DEF>
                <ECUC-BOOLEAN-PARAM-DEF UUID="a3b9bd1e-a0e0-45e0-8a10-0339f0297de3">
                  <SHORT-NAME>CryptoLibAutronCsecSecureBootApply</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Whether the secure boot configurations are applied.&#xD;
true : try to apply secure boot configurations when initializing CSEc&#xD;
false : Do not try to apply secure boot configurations when initializing CSEc</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <ORIGIN>AUTRON</ORIGIN>
                  <DEFAULT-VALUE>false</DEFAULT-VALUE>
                </ECUC-BOOLEAN-PARAM-DEF>
              </PARAMETERS>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES></AUTOSAR>
