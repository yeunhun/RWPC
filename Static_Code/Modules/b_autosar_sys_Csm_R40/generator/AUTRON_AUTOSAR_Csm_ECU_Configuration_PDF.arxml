                    <ECUC-BOOLEAN-PARAM-DEF UUID="1bbe91d7-008e-45e2-94ca-e1fd073b29f8">
                      <SHORT-NAME>CsmSymKeyWrapSymUsePort</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Need to use RTE interfaces?</L-2>
                      </DESC>
